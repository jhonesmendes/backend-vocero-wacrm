# ============================================================
# OBRIGATÓRIO — o aplicativo não inicia sem estes dados.
# ============================================================

# Supabase (Configurações do Projeto → API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Chave service-role do Supabase. Ignora as políticas RLS;
# usada somente em rotas do servidor (webhook, mecanismo de automação
# e autenticação da API pública — consulte docs/public-api.md).
# Mantenha esta chave em segredo — nunca coloque em código do cliente.
#
# Observação: a API pública (/api/v1) não precisa de uma nova variável
# de ambiente. As chaves da API são criadas no painel (Configurações →
# Chaves da API) e armazenadas com hash no banco de dados; esta chave
# service-role permite que o processo de autenticação procure uma chave
# apresentada sem exigir uma sessão do usuário.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Criptografia dos tokens do WhatsApp (64 caracteres hexadecimais = 32 bytes,
# AES-256-GCM).
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Alterar este valor fará com que todos os tokens criptografados com a chave
# anterior fiquem inutilizados — os usuários precisarão salvar novamente
# suas configurações do WhatsApp para reconectar.
ENCRYPTION_KEY=sua-chave-hexadecimal-de-64-caracteres

# Segredo do aplicativo Meta (Meta for Developers → Configurações do App → Básico).
# Verifica a assinatura HMAC-SHA256 em cada requisição POST recebida pelo webhook.
# Obrigatório — sem ele, o webhook rejeitará todas as requisições.
META_APP_SECRET=seu-meta-app-secret

# ============================================================
# RECOMENDADO — existem valores padrão seguros, mas é recomendável configurar.
# ============================================================

# URL pública principal desta instalação (esquema + domínio, sem barra no final).
# Usada para o sitemap e imagens OG.
# As rotas que precisam gerar uma URL da própria aplicação (links de convite
# de /api/account/invitations e futuros links enviados por e-mail) obtêm
# a origem diretamente da requisição.
#
# Esta variável só é necessária quando a origem obtida pela requisição
# estiver incorreta — por exemplo, ao gerar links por cron ou por um
# processo em segundo plano que não possui uma requisição recebida.
NEXT_PUBLIC_SITE_URL=https://crm.seudominio.com

# Idioma padrão da aplicação (ex.: pt-BR)
NEXT_PUBLIC_APP_LOCALE=pt-BR

# ============================================================
# OPCIONAL — necessário somente se você utilizar o recurso.
# ============================================================

# Lista de permissões adicional para os domínios que
# /api/account/invitations aceita publicar nos links de convite.
# Separados por vírgula, sem protocolo e sem porta (somente os domínios).
#
# Exemplo:
# ALLOWED_INVITE_HOSTS=crm.seudominio.com,crm-staging.seudominio.com

# Segredo compartilhado que protege GET /api/automations/cron.
# Obrigatório se você usar etapas "Wait" nas automações
# (um processo agendado verifica e executa as tarefas pendentes).
# Gere uma string longa e aleatória:
#   openssl rand -hex 32
#
# Consulte docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=gere-uma-string-longa-e-aleatoria

# ID do aplicativo Meta (Meta for Developers → Configurações do App → Básico).
# Necessário para criar/editar modelos de mensagens que possuem cabeçalho
# com IMAGEM.
#
# A Meta aceita somente um identificador de mídia de upload resumível
# (Resumable Upload), e não uma URL simples, como exemplo do cabeçalho.
# Esse upload é específico do aplicativo.
#
# Sem esta variável, o envio de modelos com cabeçalho de imagem retornará
# um erro claro. Modelos somente com texto não são afetados.
# Use junto com META_APP_SECRET.
# META_APP_ID=seu-meta-app-id

# Quando definido como "true", o POST /api/whatsapp/templates/submit
# ignora a chamada à Meta e salva o modelo com um ID Meta fictício:
# dry-run-<uuid>
#
# Use isso em CI e desenvolvimento local para testar toda a interface
# de modelos sem precisar de uma WABA real.
#
# Deixe vazio ou como "false" em produção.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# Assistente de respostas com IA (opcional)
# ------------------------------------------------------------------

# O assistente de IA funciona com chave fornecida pelo próprio usuário:
# cada conta informa sua própria chave da OpenAI ou Anthropic em
# Configurações → Assistente de IA.
#
# A chave é armazenada criptografada usando AES-256-GCM com a
# ENCRYPTION_KEY acima.
#
# NÃO existe uma chave global do provedor nas variáveis de ambiente.
# Portanto, nenhuma variável abaixo é obrigatória para o recurso funcionar.
#
# A base de conhecimento da IA (migração 030) utiliza pesquisa
# de texto completo do PostgreSQL por padrão.
#
# A pesquisa semântica opcional necessita da extensão pgvector.
# A migração 030 executa:
#   CREATE EXTENSION IF NOT EXISTS vector
#
# O Supabase disponibiliza essa extensão.
# Também é necessário configurar uma chave de embeddings por conta
# em Configurações → Assistente de IA.
#
# Nenhuma variável de ambiente adicional é necessária.

# Tempo limite por requisição ao provedor de IA, em milissegundos.
# Padrão: 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# Quantidade de mensagens de texto recentes de uma conversa que serão
# enviadas ao modelo como contexto (rascunho + resposta automática).
# Padrão: 20.
# AI_CONTEXT_MESSAGE_LIMIT=20